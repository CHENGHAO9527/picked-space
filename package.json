{
  "name": "picked-space",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "按自己的注意力组织B站内容的本地私人放映厅",
  "scripts": {
    "dev": "npm --prefix shicang-next run dev",
    "build": "npm --prefix shicang-next run build",
    "start": "npm --prefix shicang-next run start",
    "typecheck": "npm --prefix shicang-next run typecheck",
    "test": "npm run check:public && npm run test:legacy && npm --prefix shicang-next test",
    "test:legacy": "node --test tests/*.test.mjs",
    "start:legacy": "node --use-env-proxy server.mjs",
    "package:template": "node scripts/package-template.mjs",
    "check:public": "node scripts/check-public-scope.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.5"
  }
}
