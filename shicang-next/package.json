  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "drizzle-orm": "1.0.0-rc.5",
    "html-to-image": "1.11.13",
    "lunar-javascript": "1.7.8",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.5"
  }
